# Matched PyTorch/Triton build validated on MI355X (gfx950).
FROM rocm/pytorch:rocm10.1.0_ubuntu24.04_py3.12_pytorch_release_2.14.0@sha256:099f59a3bee9c436f5cc57db6bc6076fdeda579c57e9e22ae40f856d5905b3e4
WORKDIR /opt/startlux-prism
COPY requirements-rocm.txt ./
RUN python3 -m pip install --no-cache-dir -r requirements-rocm.txt
COPY startlux_prism ./startlux_prism
ENV OMP_NUM_THREADS=8
ENTRYPOINT ["python3", "-m", "startlux_prism.server"]
